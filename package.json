{
  "name": "int161-exam-kit",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "INT161 ready-to-adapt Express ESM and MySQL exam template",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js tests/db-guard.test.js",
    "verify:template": "node --env-file-if-exists=.env scripts/verify-template.mjs",
    "package:kit": "node scripts/package-kit.mjs",
    "verify:offline": "node --env-file-if-exists=.env scripts/verify-offline.mjs",
    "study": "node local-study/server.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "mysql2": "3.24.3",
    "http-status": "2.1.0"
  }
}
